{
  "name": "glassleaf",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "mobile": "pnpm --filter @glassleaf/mobile start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @glassleaf/library test && pnpm --filter @glassleaf/mcp test && pnpm --filter @glassleaf/library exec tsx ../../scripts/check-mobile-themes.ts",
    "mcp": "pnpm --filter @glassleaf/mcp start",
    "format:check": "prettier --check apps/mobile/App.tsx \"apps/mobile/src/**/*.{ts,tsx}\" \"packages/{library,mcp}/src/*.ts\""
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
